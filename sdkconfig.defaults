# Target: ESP32-S2 (WROVER, 4MB flash)
CONFIG_IDF_TARGET="esp32s2"

# Console on native USB-CDC so the Flipper-link UART pins (GPIO43/44) stay free.
CONFIG_ESP_CONSOLE_USB_CDC=y
# (disable the default UART0 console)
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# 4MB flash + our custom single-app table (dual-boot table comes later)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# A little FreeRTOS headroom for the two tasks
CONFIG_FREERTOS_HZ=1000
